# ===== رصد الهلال — المفاتيح (انسخ هذا الملف باسم .env واملأ ما عندك) =====
# حساب X للرصد (من متصفح مسجّل الدخول: الكوكي auth_token)
X_AUTH_TOKEN=
X_CT0=
# حساب X الاحتياطي (لاحقًا)
X_AUTH_TOKEN_2=
# تيك توك (الكوكيز كاملة من متصفح مسجّل الدخول بحساب الرصد، بصيغة name=value; name2=value2)
TIKTOK_COOKIES=
# الذكاء الاصطناعي المجاني
GEMINI_API_KEY=
GROQ_API_KEY=
# التنبيهات
PUSHOVER_TOKEN=
PUSHOVER_USER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# جسر Google Sheets (من خطوة Apps Script)
SHEET_WEBAPP_URL=
SHEET_SECRET=
# مراقبة الصحة (Healthchecks.io)
HEALTHCHECK_URL=
# بحث الويب (بديل X وتيك توك + المنتديات) — واحد منهما يكفي
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# اختياري
YOUTUBE_API_KEY=
GOOGLE_PLACES_KEY=
# SRCA_SOURCES=x,tiktok,news,youtube,telegram,apps,reddit,web,maps
# SRCA_INTERVAL_MIN=30
